{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build:vercel",
  "regions": ["syd1"],
  "crons": [
    {
      "path": "/api/cron/woolworths",
      "schedule": "10 16 * * 0"
    },
    {
      "path": "/api/cron/supermarkets?retailer=paknsave",
      "schedule": "20 17 * * 0"
    },
    {
      "path": "/api/cron/supermarkets?retailer=newworld",
      "schedule": "30 18 * * 0"
    },
    {
      "path": "/api/cron/supermarkets?retailer=foursquare",
      "schedule": "40 19 * * 0"
    },
    {
      "path": "/api/cron/supermarkets?retailer=freshchoice",
      "schedule": "50 20 * * 0"
    },
    {
      "path": "/api/cron/supermarkets?retailer=supervalue",
      "schedule": "0 22 * * 0"
    }
  ]
}
