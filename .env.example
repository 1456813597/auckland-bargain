SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: the anonymous Woolworths site defaults to Glenfield (store 9171).
# Set a browser session cookie only when you intentionally select another store.
WOOLWORTHS_COOKIE=
WOOLWORTHS_STORE_CITY=Auckland
WOOLWORTHS_MAX_PAGES=60
WOOLWORTHS_PAGE_SIZE=100

# The first PAK'nSAVE collector defaults to the real Royal Oak store.
# Prefer STORE_ID for an exact, stable selection when changing stores.
PAKNSAVE_STORE_ID=e1925ea7-01bc-4358-ae7c-c6502da5ab12
PAKNSAVE_STORE_QUERY=Royal Oak
PAKNSAVE_STORE_CITY=Auckland
PAKNSAVE_MAX_PAGES=12

# Used for absolute social-preview URLs.
SITE_URL=http://localhost:3000
