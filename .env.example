# Copy to `.env` next to docker-compose.yml on the server, or to `.env.local`
# for development. Never commit the filled-in copy.

# ─── Database ────────────────────────────────────────────────────────────────
# Pick one of the two. With both set, DATABASE_URL wins unless DATABASE_DRIVER
# says otherwise.
#
# 1. A Postgres you run yourself (the aaPanel/Baota PostgreSQL manager, or any
#    other server). Use the same user for migrations and the app so it owns the
#    tables it created.
DATABASE_URL=postgresql://auckland:password@127.0.0.1:5432/auckland_bargain
# `disable` for a private network, `require` for a managed provider, or
# `verify-full` with DATABASE_SSL_CA. Unset follows the connection string.
DATABASE_SSL=
DATABASE_SSL_CA=
DATABASE_POOL_MAX=10

# 2. Supabase. The secret key is server-only; never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# The direct (non-pooled) connection Supabase exposes for migrations.
POSTGRES_URL_NON_POOLING=

# Force a driver instead of letting the variables above decide: postgres | supabase
DATABASE_DRIVER=

# ─── Collection scheduling ───────────────────────────────────────────────────
# Required. The scheduler sends this as a bearer token and every /api/cron route
# rejects anything else. At least 16 random characters.
CRON_SECRET=

# Schedules are read in this zone, so daylight saving does not move them.
CRON_TZ=Pacific/Auckland
# Five cron fields, or `off` to disable one job. Defaults come from
# deploy/cron-jobs.json; the weekly banner jobs are spaced 70 minutes apart so
# two collections never overlap.
CRON_COLLECT_SCHEDULE=0 * * * *
CRON_WOOLWORTHS_SCHEDULE=10 4 * * 1
CRON_PAKNSAVE_SCHEDULE=20 5 * * 1
CRON_NEWWORLD_SCHEDULE=30 6 * * 1
CRON_FOURSQUARE_SCHEDULE=40 7 * * 1
CRON_FRESHCHOICE_SCHEDULE=50 8 * * 1
CRON_SUPERVALUE_SCHEDULE=0 10 * * 1
# How long one call may take before the scheduler gives up on it.
CRON_TIMEOUT_SECONDS=1800

# Queue drain limits for /api/cron/collect. A server you own has no serverless
# time limit, so these can be raised well above the old platform defaults.
COLLECTION_JOB_LIMIT=3
COLLECTION_JOB_MAX_LIMIT=10
COLLECTION_CLAIM_DEADLINE_MS=120000

# ─── Product images ──────────────────────────────────────────────────────────
# Where mirrored retailer images are written. Inside the container this is the
# mounted volume; leave it as-is unless the compose file changes.
PRODUCT_IMAGE_DIR=/data/product-images
# Set to `off` to stop mirroring new images while still serving stored ones.
PRODUCT_IMAGE_MIRROR=
# Disk ceiling for the store. Reaching it keeps retailer URLs instead of filling
# the volume. Default 8 GiB.
PRODUCT_IMAGE_MIRROR_MAX_BYTES=
# Only needed when the images are served from another origin (a CDN, or a
# separate static domain). Empty means relative `/product-images/...` URLs.
PRODUCT_IMAGE_BASE_URL=

# ─── Docker Compose ──────────────────────────────────────────────────────────
# Published images. Override to deploy a fork's own registry namespace.
APP_IMAGE=ghcr.io/1456813597/auckland-bargain:latest
SCHEDULER_IMAGE=ghcr.io/1456813597/auckland-bargain-scheduler:latest
# The host port and interface the site is published on. Keep 127.0.0.1 when a
# panel-managed nginx site reverse-proxies to it.
APP_BIND=127.0.0.1
APP_PORT=3000
APP_INTERNAL_URL=http://app:3000

# ─── Application ─────────────────────────────────────────────────────────────
# Used for absolute social-preview URLs.
SITE_URL=http://localhost:3000
# How long the in-process comparison snapshot is reused, in milliseconds.
COMPARISON_SNAPSHOT_MS=

# ─── Retailer store selection ────────────────────────────────────────────────
# Optional: the anonymous Woolworths site defaults to Glenfield (store 9171).
# Set a browser session cookie only when you intentionally select another store.
WOOLWORTHS_COOKIE=
WOOLWORTHS_STORE_CITY=Auckland
WOOLWORTHS_MAX_PAGES=60
WOOLWORTHS_PAGE_SIZE=100

# The first PAK'nSAVE collector defaults to the real Royal Oak store.
# Prefer STORE_ID for an exact, stable selection when changing stores.
PAKNSAVE_STORE_ID=e1925ea7-01bc-4358-ae7c-c6502da5ab12
PAKNSAVE_STORE_QUERY=Royal Oak
PAKNSAVE_STORE_CITY=Auckland
PAKNSAVE_MAX_PAGES=20

# New World uses the same Foodstuffs collection core and defaults to Metro Queen St.
NEWWORLD_STORE_ID=
NEWWORLD_STORE_QUERY=Metro Queen St
NEWWORLD_STORE_CITY=Auckland
NEWWORLD_MAX_PAGES=20

# Four Square exposes a nationwide store directory. The default is Lancaster;
# use either an exact GUID or a unique store-name fragment.
FOURSQUARE_STORE_ID={B607A601-34F0-4441-8D6D-702490B58400}
FOURSQUARE_STORE_QUERY=Lancaster
FOURSQUARE_STORE_CITY=Auckland
FOURSQUARE_MAX_PAGES=10

# FreshChoice and SuperValue stores use store-specific MyFoodLink origins.
# Point these values at the locality represented by your comparison site.
FRESHCHOICE_STORE_ORIGIN=https://epsom.store.freshchoice.co.nz
FRESHCHOICE_STORE_CITY=Auckland
FRESHCHOICE_STORE_ADDRESS=233A Green Lane West, Epsom, Auckland 1051
FRESHCHOICE_MAX_PAGES=80

SUPERVALUE_STORE_ORIGIN=https://milton.store.supervalue.co.nz
SUPERVALUE_STORE_CITY=Milton
SUPERVALUE_STORE_ADDRESS=59 Union Street, Milton 9220
SUPERVALUE_MAX_PAGES=60
