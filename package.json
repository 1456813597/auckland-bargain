{
  "name": "auckland-bargain",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "ci": "npm run test && npm run typecheck && npm run lint && npm run build",
    "test": "tsx --test test/**/*.test.ts",
    "deals:refresh": "tsx scripts/refresh-local-deals.ts",
    "stores:plan": "tsx scripts/refresh-registered-stores.ts",
    "stores:refresh": "tsx scripts/refresh-registered-stores.ts --execute",
    "queue:sync": "tsx scripts/collection-queue.ts sync",
    "queue:status": "tsx scripts/collection-queue.ts status",
    "queue:enqueue": "tsx scripts/collection-queue.ts enqueue",
    "queue:work": "tsx scripts/collection-queue.ts work",
    "typecheck": "next typegen && tsc --noEmit",
    "release:ready": "tsx scripts/check-release-readiness.ts",
    "lint": "oxlint",
    "lint:type-aware": "oxlint --type-aware --type-check",
    "format": "oxfmt",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:check": "node scripts/migrate.mjs --dry-run",
    "images:index": "tsx scripts/image-index.ts",
    "images:index:adopt": "tsx scripts/image-index.ts --execute"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "@supabase/supabase-js": "2.112.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "next": "16.3.3",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-day-picker": "9.8.1",
    "react-dom": "19.2.6",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@next/env": "16.3.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "supabase": "2.116.0",
    "tailwindcss": "4.2.1",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  },
  "type": "module"
}
